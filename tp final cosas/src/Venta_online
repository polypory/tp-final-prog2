    @Override
    public void aplicar_descuento() {
        int descuento=0;
        if( usuario_comprador.getCantidad_compras()==1){
            descuento=20;
        }
        else if( usuario_comprador.getCantidad_compras()>50){
            descuento=10;
        }
        else if( usuario_comprador.getCantidad_compras()>100){
            descuento=20;
        }

        double subtotal = getSubtotal();
        setTotal(subtotal - (subtotal * descuento));
    }
